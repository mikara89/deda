# Required. Do not put secrets in this file after copying it.
export HCLOUD_TOKEN=
export DEDA_IMAGE=ghcr.io/mikara89/deda:v0.2.0-preview.1
export DEDA_QUAL_SSH_CIDR=203.0.113.10/32

# Optional defaults.
export DEDA_QUAL_LOCATION=nbg1
export DEDA_QUAL_SERVER_TYPE=cx23
export DEDA_QUAL_IMAGE=ubuntu-24.04
export DEDA_QUAL_NETWORK_CIDR=10.42.0.0/16
export DEDA_QUAL_SUBNET_CIDR=10.42.0.0/24
export DEDA_QUAL_NETWORK_ZONE=eu-central
export DEDA_QUAL_PREFIX=deda-q
# Optional runtime-state override. WSL repositories under /mnt automatically
# use ~/.local/state/deda-qualification/hetzner so SSH keys can be mode 0600.
# export DEDA_QUAL_RUNTIME_ROOT="$HOME/.local/state/deda-qualification/hetzner"
# DEDA_QUAL_DRY_RUN=1 makes provision.sh validate and print only.
