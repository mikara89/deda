#!/bin/sh
set -eu

duration=${SIMULATED_JOB_SECONDS:-60}

case "$1" in
  register)
    printf '%s\n' register >&2
    exit 0
    ;;
  unregister)
    printf '%s\n' cleanup >&2
    exit 0
    ;;
  run)
    job=$(hostname 2>/dev/null || uname -n 2>/dev/null || echo task)
    printf 'job=%s provider=gitlab event=started at=%s\n' "$job" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    sleep "$duration" & child=$!
    drain() {
      printf 'job=%s provider=gitlab event=drain-signal signal=%s at=%s\n' "$job" "$1" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      wait "$child"
      printf 'job=%s provider=gitlab event=completed-after-drain at=%s\n' "$job" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      exit 0
    }
    trap 'drain QUIT' QUIT
    trap 'drain TERM' TERM
    trap 'drain INT' INT
    wait "$child"
    printf 'job=%s provider=gitlab event=completed at=%s\n' "$job" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    ;;
esac
