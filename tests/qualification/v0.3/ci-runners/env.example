# A specific immutable candidate image is required for Swarm qualification.
DEDA_IMAGE=deda:qualification
DEDA_QUAL_STACK=deda-v03-qual
# Set only for local operator runs; normal CI supplies its own image.
DEDA_QUAL_RUN_FULL=false

# Real-provider qualification is explicitly operator-run. These image
# references must be immutable digest references and must identify the same
# candidate used by the deterministic run.
# For a release-qualification attempt, run-deterministic.sh with
# DEDA_IMAGE=$REAL_DEDA_IMAGE before real/run-all.sh.
REAL_DEDA_IMAGE=ghcr.io/mikara89/deda@sha256:REPLACE_WITH_CANDIDATE_DIGEST
GITHUB_QUAL_RUNNER_IMAGE=ghcr.io/mikara89/deda-github-runner@sha256:REPLACE_WITH_RUNNER_DIGEST
AZURE_QUAL_RUNNER_IMAGE=ghcr.io/mikara89/deda-azure-runner@sha256:REPLACE_WITH_RUNNER_DIGEST
GITLAB_QUAL_RUNNER_IMAGE=ghcr.io/mikara89/deda-gitlab-runner@sha256:REPLACE_WITH_RUNNER_DIGEST
GITHUB_QUAL_LABELS=self-hosted,linux,deda
AZURE_QUAL_DEMANDS=Agent.OS=Linux,deda
GITLAB_QUAL_RUN_UNTAGGED=false
REAL_GITHUB_STACK=deda-real-github
REAL_AZURE_STACK=deda-real-azure
REAL_GITLAB_STACK=deda-real-gitlab
