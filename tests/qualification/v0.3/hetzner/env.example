# Non-secret operator examples only. Do not put tokens in this file.
# Copy what you need into your shell; keep secret files outside the repository.

# Already-published prerelease to qualify. Never latest or v0.3.
export DEDA_QUAL_RC_TAG=v0.3.0-rc.2
export DEDA_QUAL_RUNNER_REGISTRY=ghcr.io/mikara89
# Optional override of the published DEDA repository name.
# export DEDA_QUAL_DEDA_REPOSITORY=ghcr.io/mikara89/deda

# Hetzner Cloud. Provide HCLOUD_TOKEN in the environment, not here.
export DEDA_QUAL_LOCATION=nbg1
export DEDA_QUAL_SERVER_TYPE=cx23
export DEDA_QUAL_IMAGE=ubuntu-24.04
export DEDA_QUAL_SSH_CIDR=203.0.113.10/32
export DEDA_QUAL_PREFIX=deda-q
export DEDA_QUAL_EXPIRY_HOURS=12
# This harness supports a single manager. Multi-manager HA remains v0.2.
export DEDA_QUAL_MANAGER_COUNT=1

# Optional runtime-state override. WSL repositories under /mnt automatically
# use ~/.local/state/deda-qualification/hetzner-v0.3 so SSH keys can be mode 0600.
# export DEDA_QUAL_RUNTIME_ROOT="$HOME/.local/state/deda-qualification/hetzner-v0.3"
# DEDA_QUAL_DRY_RUN=1 makes provision.sh validate and print only.

# Optional private-network defaults (used for Swarm advertise-addr).
# export DEDA_QUAL_NETWORK_CIDR=10.42.0.0/16
# export DEDA_QUAL_SUBNET_CIDR=10.42.0.0/24
# export DEDA_QUAL_NETWORK_ZONE=eu-central

# Optional registry login on the temporary VM for private candidate pulls.
# The file must remain on the operator machine; its contents are never written
# to run state or evidence.
# export DEDA_QUAL_REGISTRY_USER=
# export DEDA_QUAL_REGISTRY_TOKEN_FILE=

# GitHub Actions real-provider target metadata. Token values must be file paths.
export GITHUB_QUAL_OWNER=example-org
export GITHUB_QUAL_REPOSITORY=deda-qual
export GITHUB_QUAL_WORKFLOW=qualification.yml
export GITHUB_QUAL_REF=main
# export GITHUB_QUAL_QUEUE_TOKEN_FILE=$HOME/.config/deda-qual/github-queue.token
# export GITHUB_QUAL_RUNNER_ADMIN_TOKEN_FILE=$HOME/.config/deda-qual/github-runner.token

# Azure Pipelines real-provider target metadata.
export AZURE_QUAL_ORGANIZATION_URL=https://dev.azure.com/example-org
export AZURE_QUAL_PROJECT=deda-qual
export AZURE_QUAL_PIPELINE_ID=1
export AZURE_QUAL_POOL=deda-swarm
# export AZURE_QUAL_QUEUE_TOKEN_FILE=$HOME/.config/deda-qual/azure-queue.token
# export AZURE_QUAL_AGENT_TOKEN_FILE=$HOME/.config/deda-qual/azure-agent.token

# GitLab CI real-provider target metadata.
export GITLAB_QUAL_URL=https://gitlab.com
export GITLAB_QUAL_PROJECT=example-group/deda-qual
export GITLAB_QUAL_REF=main
export GITLAB_QUAL_TAGS=linux,deda
# export GITLAB_QUAL_QUEUE_TOKEN_FILE=$HOME/.config/deda-qual/gitlab-queue.token
# export GITLAB_QUAL_RUNNER_TOKEN_FILE=$HOME/.config/deda-qual/gitlab-runner.token

# Required separately, never committed:
#   HCLOUD_TOKEN
#   the six *TOKEN_FILE / *AGENT_TOKEN_FILE paths above
