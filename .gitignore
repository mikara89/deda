# Microsoft Azure WebApp publish profile
PublishScripts/

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows shortcuts
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Secrets / credentials — never commit
appsettings.Production.json
appsettings.Secrets.json
secrets.json
